[
  {
    "id": "invoice-review",
    "name": "Supplier invoice review",
    "area": "Finance",
    "description": "Check invoice arithmetic and dates before a reviewer prepares a manual payment instruction.",
    "reviewer": "Finance reviewer",
    "gated_action": "A payment instruction for manual processing. No payment is sent.",
    "fields": [
      {"id":"vendor","label":"Supplier","type":"text","required":true,"maxLength":160},
      {"id":"invoice_number","label":"Invoice number","type":"text","required":true,"maxLength":100},
      {"id":"invoice_date","label":"Invoice date","type":"date","required":true},
      {"id":"due_date","label":"Due date","type":"date","required":true},
      {"id":"currency","label":"Currency","type":"select","required":true,"options":["USD","EUR","GBP","INR","CAD","AUD"]},
      {"id":"subtotal","label":"Subtotal","type":"number","required":true,"min":0},
      {"id":"tax","label":"Tax","type":"number","required":true,"min":0},
      {"id":"total","label":"Total","type":"number","required":true,"min":0},
      {"id":"description","label":"What was supplied?","type":"textarea","required":true,"maxLength":1000}
    ]
  },
  {
    "id": "support-triage",
    "name": "Customer support triage",
    "area": "Customer operations",
