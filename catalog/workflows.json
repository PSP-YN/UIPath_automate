      {"id":"requested_amount","label":"Requested amount","type":"number","required":true,"min":0},
      {"id":"budget_available","label":"Available budget","type":"number","required":true,"min":0,"help":"Enter the budget figure from your organization."},
      {"id":"currency","label":"Currency","type":"select","required":true,"options":["USD","EUR","GBP","INR","CAD","AUD"]},
